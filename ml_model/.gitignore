# ===================================
# MACHINE LEARNING / DATA SCIENCE
# ===================================

# Data directories - preserve structure but ignore content
# Use .gitkeep files to maintain empty directories
# NOTE: This includes all training/validation images (medical data)
cervcareai_data/raw/**/*
!cervcareai_data/raw/.gitkeep
cervcareai_data/processed/**/*
!cervcareai_data/processed/.gitkeep
cervcareai_data/preprocessed/**/*
!cervcareai_data/preprocessed/.gitkeep
cervcareai_data/features/**/*
!cervcareai_data/features/.gitkeep
cervcareai_data/predictions/**/*
!cervcareai_data/predictions/.gitkeep
cervcareai_data/metadata/**/*
!cervcareai_data/metadata/.gitkeep

